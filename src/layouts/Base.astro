---
const { title = "AIYA - Asian Impact Youth Association", description = "AIYA Asian Impact Youth Association. AIYA is Culture & Awareness -> Voice & Youth." } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://aiya.community/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/aiya-og-image.jpg" />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://aiya.community/" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="/images/aiya-twitter-image.jpg" />
    
    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    
    <!-- Cloudflare R2 Media Styles -->
    <link rel="stylesheet" href="/src/styles/r2-media.css" />
  </head>
  <body>
    <header class="main-header">
      <div class="container">
        <h1>AIYA - Asian Impact Youth Association</h1>
        <nav class="main-nav">
          <a href="/">Home</a>
          <a href="/r2-test">R2 Test</a>
          <a href="/media-uploader">Media Uploader</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="main-footer">
      <div class="container">
        <p>&copy; {new Date().getFullYear()} AIYA Asian Impact Youth Association. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>