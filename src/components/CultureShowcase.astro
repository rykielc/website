----
/**
 * CultureShowcase.astro
 * Dual-Layer Hero Showcase with Precision 720x920 (2x Retina) Character Overlays
 * Configured for 2560x1440 Photoshop Base Integration (160px Margins / 40px Gutter)
 */

const {
  headline = "AIYA Where Youth Belong!",
  subheadline = "AIYA Asian Impact Youth Association.",
  combinedVideoBasePath = "https://media.yourdomain.com/anim/hero-combined/",
  initialPosterSrc = "/images/culture/hero-initial-poster.webp",
  settledPosterSrc = "/images/culture/hero-combined-poster.jpg"
} = Astro.props;

// Logical CSS Dimensions: 360px x 460px (Physical 100% target: 720px x 920px @2x Retina)
const LOGICAL_CARD_WIDTH = 360;
const LOGICAL_CARD_HEIGHT = 460;

const characters = [
  {
    id: "solo-01",
    name: "Amina",
    culture: "East African Streetwear",
    basePath: "https://media.yourdomain.com/anim/solo-1/",
    staticPosterSrc: "/images/culture/solo-1-poster.webp",
    description: "East African modern streetwear youth holding a digital canvas tablet emitting geometric particle trails.",
    width: LOGICAL_CARD_WIDTH,
    height: LOGICAL_CARD_HEIGHT
  },
  {
    id: "solo-02",
    name: "Mateo",
    culture: "Afro-Latino Urban",
    basePath: "https://media.yourdomain.com/anim/solo-2/",
    staticPosterSrc: "/images/culture/solo-2-poster.webp",
    description: "Afro-Latino urban youth with a modular synthesizer radiating translucent soundwaves.",
    width: LOGICAL_CARD_WIDTH,
    height: LOGICAL_CARD_HEIGHT
  },
  {
    id: "solo-03",
    name: "Yuki",
    culture: "East Asian Techwear",
    basePath: "https://media.yourdomain.com/anim/solo-3/",
    staticPosterSrc: "/images/culture/solo-3-poster.webp",
    description: "East Asian techwear youth holding an AR camera projecting holographic cultural overlays.",
    width: LOGICAL_CARD_WIDTH,
    height: LOGICAL_CARD_HEIGHT
  }
];

const schemaData = {
  "@context": "https://schema.org",
  "@type": "VisualArtwork",
  "name": "Youth and Culture Interactive Showcase",
  "description": subheadline,
  "creator": {
    "@type": "Organization",
    "name": "AIYA Culture Initiative"
  },
  "about": characters.map((c) => ({
    "@type": "Thing",
    "name": `${c.name} - ${c.culture}`,
    "description": c.description
  }))
};
---

<section class="culture-showcase-container" aria-label="Culture and Youth Interactive Showcase" data-component="culture-showcase-engine">
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

  <div class="showcase-header">
    <h1 class="showcase-headline">{headline}</h1>
    <p class="showcase-subheadline">{subheadline}</p>
  </div>

  <div class="showcase-stage" data-combined-basepath={combinedVideoBasePath}>
    
    <!-- LAYER 1: Base Photoshop Image Engine (2560x1440 Baseline) -->
    <div class="combined-video-wrapper" id="combined-video-container">
      <img 
        id="hero-initial-poster"
        src={initialPosterSrc} 
        alt="AIYA Photoshop Hero Base Graphics" 
        class="combined-poster transition-opacity duration-500 opacity-100"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        width="2560"
        height="1440"
      />

      <video 
        id="hero-combined-video" 
        class="combined-video transition-opacity duration-500 opacity-0"
        autoplay 
        muted 
        playsinline
        preload="auto"
      >
      </video>

      <img 
        id="hero-settled-poster"
        src={settledPosterSrc} 
        alt="AIYA Photoshop Hero Settled Visual" 
        class="combined-poster transition-opacity duration-500 opacity-0"
        loading="lazy"
        decoding="async"
        width="2560"
        height="1440"
      />
    </div>

    <!-- LAYER 2: 3 Positioned Character Overlays (720x920 Physical Target Alignment) -->
    <div class="character-grid">
      {characters.map((char) => (
        <article 
          class="character-card group" 
          id={`card-${char.id}`}
          data-character-id={char.id}
          data-solo-basepath={char.basePath}
          style={`--item-width: ${char.width}; --item-height: ${char.height};`}
          tabindex="0"
        >
          <div class="inline-media-wrapper">
            <!-- Static Character Fallback (360x460 logical / 720x920 physical) -->
            <img 
              class="media-static-poster" 
              src={char.staticPosterSrc} 
              alt={char.description}
              width={char.width}
              height={char.height}
              loading="eager"
              decoding="async"
            />

            <!-- Transparent HEVC / VP9 Video Stream -->
            <video 
              id={`solo-vid-${char.id}`}
              class="media-solo-video opacity-0 transition-opacity duration-300" 
              muted 
              playsinline 
              loop
              preload="none" 
              aria-hidden="true"
              width={char.width}
              height={char.height}
            >
            </video>

            <div class="media-ui-content">
              <span class="culture-tag">{char.culture}</span>
              <h3 class="character-name">{char.name}</h3>
            </div>
          </div>

          <div class="sr-only">
            <p>{char.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  class CultureShowcaseEngine {
    private container: HTMLElement;
    private combinedVideo: HTMLVideoElement | null;
    private initialPoster: HTMLImageElement | null;
    private settledPoster: HTMLImageElement | null;
    private cards: NodeListOf<HTMLElement>;

    constructor(container: HTMLElement) {
      this.container = container;
      this.combinedVideo = container.querySelector('#hero-combined-video');
      this.initialPoster = container.querySelector('#hero-initial-poster');
      this.settledPoster = container.querySelector('#hero-settled-poster');
      this.cards = container.querySelectorAll('.character-card');
      this.init();
    }

    private init(): void {
      this.setupCombinedHeroVideo();
      this.setupSoloHoverInteractions();
    }

    private resolveAdaptiveSuffix(): string {
      const viewportWidth = window.innerWidth;
      const dpr = window.devicePixelRatio || 1;
      const nav = navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } };
      
      const isDataSaver = nav.connection?.saveData === true;
      const isSlowNetwork = nav.connection?.effectiveType === 'slow-2g' || nav.connection?.effectiveType === '2g';

      if (isDataSaver || isSlowNetwork) return 'medium';
      return (viewportWidth < 640 && dpr >= 2) || dpr > 1.2 ? 'largetall_2x' : 'medium';
    }

    private setupCombinedHeroVideo(): void {
      if (!this.combinedVideo) return;
      const stage = this.container.querySelector<HTMLElement>('.showcase-stage');
      const basePath = stage?.dataset.combinedBasepath;
      if (!basePath) return;

      const suffix = this.resolveAdaptiveSuffix();
      
      const mp4 = document.createElement('source');
      mp4.src = `${basePath}${suffix}.mp4`;
      mp4.type = 'video/mp4; codecs="hvc1"';

      const webm = document.createElement('source');
      webm.src = `${basePath}${suffix}.webm`;
      webm.type = 'video/webm; codecs="vp09.00.41.08"';

      this.combinedVideo.appendChild(mp4);
      this.combinedVideo.appendChild(webm);
      this.combinedVideo.load();

      this.combinedVideo.addEventListener('playing', () => {
        this.combinedVideo?.classList.remove('opacity-0');
        this.combinedVideo?.classList.add('opacity-100');
        this.initialPoster?.classList.remove('opacity-100');
        this.initialPoster?.classList.add('opacity-0');
      });

      this.combinedVideo.addEventListener('ended', () => {
        this.settledPoster?.classList.remove('opacity-0');
        this.settledPoster?.classList.add('opacity-100');
        this.combinedVideo?.classList.remove('opacity-100');
        this.combinedVideo?.classList.add('opacity-0');
      });
      
      this.combinedVideo.play().catch((err) => {
        console.warn('[Showcase] Combined video sequence bypass:', err);
        this.settledPoster?.classList.remove('opacity-0');
        this.settledPoster?.classList.add('opacity-100');
        this.initialPoster?.classList.add('opacity-0');
      });
    }

    private setupSoloHoverInteractions(): void {
      this.cards.forEach((card) => {
        const video = card.querySelector<HTMLVideoElement>('.media-solo-video');
        const basePath = card.dataset.soloBasepath;

        if (!video || !basePath) return;

        const onEnter = () => this.handleSoloPlay(video, basePath);
        const onLeave = () => this.handleSoloReset(video);

        card.addEventListener('pointerenter', onEnter);
        card.addEventListener('pointerleave', onLeave);
        card.addEventListener('focusin', onEnter);
        card.addEventListener('focusout', onLeave);
      });
    }

    private async handleSoloPlay(video: HTMLVideoElement, basePath: string): Promise<void> {
      if (video.children.length === 0) {
        const suffix = this.resolveAdaptiveSuffix();
        
        const mp4 = document.createElement('source');
        mp4.src = `${basePath}${suffix}.mp4`;
        mp4.type = 'video/mp4; codecs="hvc1"';

        const webm = document.createElement('source');
        webm.src = `${basePath}${suffix}.webm`;
        webm.type = 'video/webm; codecs="vp09.00.41.08"';

        video.appendChild(mp4);
        video.appendChild(webm);
        video.load();
      }

      try {
        video.currentTime = 0;
        await video.play();
        video.classList.remove('opacity-0');
        video.classList.add('opacity-100');
      } catch (err) {
        console.warn('[Showcase] Solo video playback interrupted:', err);
      }
    }

    private handleSoloReset(video: HTMLVideoElement): void {
      video.pause();
      video.classList.remove('opacity-100');
      video.classList.add('opacity-0');
    }
  }

  document.addEventListener('astro:page-load', () => {
    const el = document.querySelector<HTMLElement>('[data-component="culture-showcase-engine"]');
    if (el) new CultureShowcaseEngine(el);
  });
</script>

<style>
  .culture-showcase-container {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 3rem 1rem;
    container-type: inline-size;
  }

  .showcase-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .showcase-headline {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    background: linear-gradient(180deg, #ffffff 0%, #a3a3a3 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 0.75rem;
  }

  .showcase-subheadline {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: #a3a3a3;
    max-width: 48rem;
    margin: 0 auto;
  }

  .showcase-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9; /* Matches 2560x1440 Photoshop Canvas aspect ratio */
    min-height: 600px;
    border-radius: 1.5rem;
    overflow: hidden;
    background: #09090b;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  /* Stage Background Layer */
  .combined-video-wrapper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .combined-poster,
  .combined-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Character Grid Overlay (Calibrated for 2560x1440 Photoshop target alignment) */
  .character-grid {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    
    /* Precision 40px Gutter Alignment (2.5rem * 16px root font = 40px) */
    gap: 2.5rem;
    
    /* Symmetrical 160px Padding (6.25% of 2560px canvas) */
    padding: 2rem 6.25%;
    
    height: 100%;
    width: 100%;
    max-width: 2560px;
    margin: 0 auto;
    background: rgba(0, 0, 0, 0.2);
  }

  .character-card {
    position: relative;
    aspect-ratio: var(--item-width) / var(--item-height); /* 18:23 aspect ratio */
    height: clamp(320px, 28vw, 460px); /* Logical CSS Height matching 720x920 Retina target */
    width: auto;
    flex: 0 0 auto;
    cursor: pointer;
    outline: none;
  }

  @container (max-width: 820px) {
    .showcase-stage {
      aspect-ratio: auto;
      min-height: auto;
    }

    .character-grid {
      flex-direction: column;
      padding: 1.5rem 1rem;
    }

    .character-card {
      width: 100%;
      max-width: 360px;
      height: auto;
    }
  }

  .inline-media-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: transparent;
  }

  .media-static-poster,
  .media-solo-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .media-static-poster {
    z-index: 1;
    opacity: 1;
    transition: opacity 300ms ease;
  }

  .character-card:hover .media-static-poster {
    opacity: 0;
  }

  .media-solo-video {
    z-index: 2;
    pointer-events: none;
  }

  .media-ui-content {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    right: 1rem;
    z-index: 3;
    padding: 0.75rem 1rem;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 0.75rem;
    color: #ffffff;
  }

  .culture-tag {
    font-size: 0.75rem;
    text-transform: uppercase;
    color: #c084fc;
    font-weight: 600;
    letter-spacing: 0.05em;
    display: block;
  }

  .character-name {
    font-size: 1rem;
    font-weight: 700;
    margin: 0.15rem 0 0 0;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>