---
import { getEmDashEntry } from "emdash";
import Base from "../layouts/Base.astro";
import MarketingBlocks from "../components/MarketingBlocks.astro";

const { entry: page, cacheHint } = await getEmDashEntry("pages", "home");

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const pageTitle = page?.data.title;
const pageContent = page?.data.content;
---

<Base
	title={pageTitle !== "Home" ? pageTitle : undefined}
	description="AIYA Asian Impact Youth Association. AIYA is Culture & Awareness -> Voice & Youth."
>
	<div class="home-page">
		<!-- Hero Section with Animation - Always visible -->
		<section class="hero-section">
			<h1>AIYA Where Youth Belong!</h1>
			<p>AIYA Asian Impact Youth Association</p>
			<div class="hero-animation">
				<div class="pulse-circle"></div>
				<div class="floating-shapes">
					<div class="shape shape-1"></div>
					<div class="shape shape-2"></div>
					<div class="shape shape-3"></div>
				</div>
			</div>
		</section>

		<!-- Main Content Area -->
		<div class="content-wrapper">
			{
				pageContent ? (
					<MarketingBlocks value={pageContent} />
				) : (
					<div class="fallback-content">
						<h2>Featured Interactive Digital Showcase</h2>
						<p>Highlighting global youth culture and digital creation tools.</p>
						<h2>Community Impact</h2>
						<p>Building bridges between Asian communities and the broader society through youth engagement.</p>
						<div class="test-media-uploader">
							<a href="/_emdash/admin" class="btn btn-primary">TestMedia Uploader</a>
						</div>
					</div>
				)
			}
		</div>
	</div>
</Base>

<style>
	/* Global styles for hero animations */
	.home-page {
		text-align: center;
		padding: 2rem;
	}

	.hero-section {
		margin: 3rem 0;
		padding: 3rem 2rem;
		background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
		border-radius: 1rem;
		color: white;
		position: relative;
		overflow: hidden;
	}

	.hero-section h1 {
		font-size: 2.5rem;
		margin-bottom: 1rem;
		animation: fadeInUp 1s ease-out;
	}

	.hero-section p {
		font-size: 1.2rem;
		opacity: 0.9;
		animation: fadeInUp 1s ease-out 0.3s both;
	}

	/* Animation container */
	.hero-animation {
		position: relative;
		width: 100px;
		height: 100px;
		margin: 2rem auto 0;
	}

	/* Pulse circle animation */
	.pulse-circle {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 80px;
		height: 80px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.3);
		animation: pulse 2s infinite;
	}

	/* Floating shapes container */
	.floating-shapes {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 100px;
		height: 100px;
	}

	/* Individual floating shapes */
	.shape {
		position: absolute;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.7);
		animation: float 6s ease-in-out infinite;
	}

	.shape-1 {
		width: 20px;
		height: 20px;
		top: 0;
		left: 30px;
		animation-delay: 0s;
	}

	.shape-2 {
		width: 15px;
		height: 15px;
		top: 40px;
		right: 20px;
		animation-delay: 1s;
	}

	.shape-3 {
		width: 25px;
		height: 25px;
		bottom: 20px;
		left: 10px;
		animation-delay: 2s;
	}

	.content-wrapper {
		margin-top: 2rem;
	}

	.fallback-content {
		max-width: 800px;
		margin: 0 auto;
		padding: 2rem;
		background: #f8fafc;
		border-radius: 1rem;
		text-align: left;
	}

	.fallback-content h2 {
		color: #3b82f6;
		margin-bottom: 1rem;
	}

	.test-media-uploader {
		margin-top: 2rem;
		text-align: center;
	}

	.btn {
		display: inline-block;
		padding: 0.75rem 1.5rem;
		background-color: #3b82f6;
		color: white;
		text-decoration: none;
		border-radius: 0.5rem;
		transition: background-color 0.3s ease;
	}

	.btn:hover {
		background-color: #2563eb;
	}

	/* Keyframe animations */
	@keyframes pulse {
		0% {
			transform: translate(-50%, -50%) scale(1);
			opacity: 0.7;
		}
		50% {
			transform: translate(-50%, -50%) scale(1.2);
			opacity: 0.3;
		}
		100% {
			transform: translate(-50%, -50%) scale(1);
			opacity: 0.7;
		}
	}

	@keyframes float {
		0% {
			transform: translateY(0) rotate(0deg);
			opacity: 0.7;
		}
		50% {
			transform: translateY(-20px) rotate(180deg);
			opacity: 0.9;
		}
		100% {
			transform: translateY(0) rotate(360deg);
			opacity: 0.7;
		}
	}

	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>
